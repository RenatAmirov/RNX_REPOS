{
  "manifest_version": 3,
  "name": "Word Frequency for PDF",
  "version": "1.0",
  "description": "Показывает размер слов по частоте в PDF: при наведении на абзац и при выделении текста.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["*://*/*.pdf", "*://*/*.PDF"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.js", "pdfjs/pdf.min.js", "pdfjs/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}