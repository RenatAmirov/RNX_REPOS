{
  "manifest_version": 3,
  "name": "Paragraph Analyzer with Emphasis",
  "version": "1.0",
  "description": "Shows a tooltip with text where word size/weight depends on frequency, subjects and predicates are underlined.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/compromise.min.js", "lib/az.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}